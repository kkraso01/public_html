          <form class="flex flex-col gap-4" onsubmit="event.preventDefault(); window.closeLeadModal();">
            <input type="text" placeholder="Ваше имя" class="w-full bg-[rgba(193,127,89,0.06)] border border-[rgba(193,127,89,0.2)] rounded-lg px-4 py-3.5 text-[var(--color-cream)] text-sm outline-none focus:border-[var(--color-copper)] transition-colors placeholder-[var(--color-text-muted)]" required="">
            <input type="tel" placeholder="Номер телефона" class="w-full bg-[rgba(193,127,89,0.06)] border border-[rgba(193,127,89,0.2)] rounded-lg px-4 py-3.5 text-[var(--color-cream)] text-sm outline-none focus:border-[var(--color-copper)] transition-colors placeholder-[var(--color-text-muted)]" required="">
            <button type="submit" class="btn btn-primary w-full justify-center mt-2 border-none py-3.5">
